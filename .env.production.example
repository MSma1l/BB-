# =============================================================================
# Balloons Breeze — PRODUCTION environment template
# =============================================================================
# Copy to `.env` on the server and fill in real values:  cp .env.production.example .env
# NEVER commit the resulting .env — it holds live secrets. Keep it 0600.
#
# Generate strong secrets on the server, e.g.:
#   openssl rand -hex 32     # 64 hex chars — good for JWT_SECRET / passwords
#   openssl rand -base64 24  # alternative
# =============================================================================

# ---- Postgres (db service) ----
POSTGRES_USER=bb                                       # database user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD         # generate: openssl rand -hex 24
POSTGRES_DB=balloons                                   # database name

# ---- Backend: Prisma connection ----
# Host is the compose service name "db". The password segment below MUST MATCH
# POSTGRES_PASSWORD above, character-for-character, or the backend can't connect.
DATABASE_URL=postgresql://bb:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/balloons?schema=public

# ---- Backend: auth / JWT ----
JWT_SECRET=CHANGE_ME_LONG_RANDOM                       # generate: openssl rand -hex 32
JWT_EXPIRES_IN=12h                                     # access-token lifetime
ADMIN_USERNAME=admin                                   # seeded admin login
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD         # generate: openssl rand -base64 18

# ---- Backend: uploads ----
MAX_UPLOAD_MB=8                                        # max upload size (MB); host nginx allows 12m
UPLOAD_DIR=uploads                                     # upload dir (relative to /app; backed by the "uploads" volume)

# ---- Edge protection (nginx HTTP Basic Auth on /admin-bb) ----
EDGE_AUTH_USER=admin                                   # Basic Auth user gating /admin-bb (defense-in-depth over JWT)
EDGE_AUTH_PASSWORD=CHANGE_ME_STRONG_EDGE_PASSWORD      # generate: openssl rand -base64 18

# ---- Web / networking ----
WEB_PORT=8080                                          # host port for nginx web proxy; in prod it's bound to 127.0.0.1 only
NODE_ENV=production                                    # backend runtime mode (makes JWT_SECRET mandatory)
PORT=4000                                              # backend listen port (internal, not published)
NEXT_PUBLIC_API_URL=/api                               # baked into the frontend build; same-origin API base — leave as /api
CORS_ORIGIN=https://your-domain.com                    # your real public origin (single origin behind the same-origin proxy)
