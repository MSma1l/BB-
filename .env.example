# ---- Postgres (db service) ----
POSTGRES_USER=bb                                      # database user
POSTGRES_PASSWORD=change-me-strong                    # database password (change in prod!)
POSTGRES_DB=balloons                                  # database name

# ---- Backend: Prisma connection ----
# Host is the compose service name "db"; creds MUST match POSTGRES_* above.
DATABASE_URL=postgresql://bb:change-me-strong@db:5432/balloons?schema=public

# ---- Backend: auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-string          # sign admin JWTs (use a long random string)
JWT_EXPIRES_IN=12h                                    # access-token lifetime
ADMIN_USERNAME=admin                                  # seeded admin login
ADMIN_PASSWORD=bbreeze-admin                          # seeded admin password (change in prod!)

# ---- Backend: uploads ----
MAX_UPLOAD_MB=12                                       # max RAW upload accepted (MB), before compression
IMAGE_MAX_MB=5                                         # hard ceiling for the STORED image after WebP compression
UPLOAD_DIR=uploads                                     # upload dir (relative to /app; backed by the "uploads" volume)

# ---- Web / networking ----
WEB_PORT=8080                                          # host port for the nginx web proxy
NODE_ENV=production                                    # backend runtime mode
PORT=4000                                              # backend listen port (internal)
NEXT_PUBLIC_API_URL=/api                               # baked into the frontend build; same-origin API base
CORS_ORIGIN=*                                          # allowed CORS origin (single origin => not strictly needed)

# ---- Telegram notifier (optional) ----
# Get a token from @BotFather. When set, new visitor chat messages are pushed to
# your Telegram group. Add the bot to a group (Topics enabled), then send
# /register in that group — the bot auto-creates a topic and remembers the chat.
# Leave empty to disable the feature.
TELEGRAM_BOT_TOKEN=                                    # <bot-id>:<token> from @BotFather
PUBLIC_SITE_URL=https://your-domain.com                # used to build the admin-panel link in notifications
